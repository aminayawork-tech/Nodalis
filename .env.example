# Postgres connection string (Prisma Postgres, Vercel Postgres, Neon, Supabase, or your own).
# Use the DIRECT (non-pooled) connection string — this app uses the @prisma/adapter-pg
# driver adapter, which manages its own connection pool.
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# Anthropic API key, used for narrative synthesis. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Firecrawl API key, used to scrape source articles for a topic. Get one at https://www.firecrawl.dev
# Leave unset to fall back to a stub scraper (returns no sources; synthesis will note it can't verify details).
FIRECRAWL_API_KEY=

# Shared secret required (as ?secret=... or Authorization: Bearer ...) to call /api/cron/refresh.
CRON_SECRET=changeme
