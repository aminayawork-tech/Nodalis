# Postgres connection string — Vercel Postgres (Storage tab → Create
# Database → Postgres) is the recommended provider: it's provisioned right
# inside your Vercel project, so there's no separate account/dashboard that
# can silently pause or delete the database from inactivity.
#
# Use the DIRECT (non-pooled) connection string, not the pooled one. This
# app is single-user/low-traffic, so there's no real need for a connection
# pooler — and using the direct string for everything avoids the class of
# bug where a pooler's transaction mode breaks Prisma Migrate's
# session-level locking (this bit us on a previous provider). Vercel
# Postgres's direct connection isn't IPv6-only, so it reaches Vercel's
# serverless functions fine either way.
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# Anthropic API key, used for narrative synthesis. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Firecrawl API key, used to scrape source articles for a topic. Get one at https://www.firecrawl.dev
# Leave unset to fall back to a stub scraper (returns no sources; synthesis will note it can't verify details).
FIRECRAWL_API_KEY=

# SerpApi key, used for the "Trending Now" dashboard panel and the daily
# refresh job's trend discovery (SerpApi's Google Trends Trending Now
# engine). Get one at https://serpapi.com. Leave unset to fall back to a
# Firecrawl+Claude approximation of "what's trending."
SERPAPI_API_KEY=

# Shared secret required (as ?secret=... or Authorization: Bearer ...) to call /api/cron/refresh.
CRON_SECRET=changeme
